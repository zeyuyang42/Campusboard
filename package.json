{
  "name": "bandcamp-player",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "web"
  ],
  "scripts": {
    "dev": "tauri dev",
    "dev:copy-library": "node scripts/dev-copy-library.mjs",
    "build": "tauri build",
    "tauri": "tauri",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "test": "npm run test -w packages/core && npm run test -w web",
    "typecheck": "npm run typecheck -w packages/core && npm run typecheck -w web",
    "scrape": "npx tsx packages/core/scripts/scrape.ts",
    "fixtures:save": "npx tsx packages/core/scripts/saveFixture.ts",
    "smoke:live": "npx tsx packages/core/scripts/smokeLive.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
