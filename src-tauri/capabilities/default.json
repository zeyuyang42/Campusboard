{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: local database, Bandcamp fetches, theme backgrounds, the offline folder and dialog-picked files",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "core:app:allow-exit",
    "allow-library-db-url",
    "allow-backup-library",
    "allow-selftest-take-backup",
    "allow-selftest-file",
    "allow-selftest-window",
    "allow-selftest-sleep",
    "allow-toggle-mini-player",
    "allow-hide-main-window",
    "allow-selftest-menu",
    "allow-set-menu-bar",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.bandcamp.com"
        },
        {
          "url": "https://bandcamp.com"
        },
        {
          "url": "https://*.bcbits.com"
        },
        {
          "url": "https://*/album/*"
        },
        {
          "url": "https://*/track/*"
        },
        {
          "url": "https://*/music"
        }
      ],
      "deny": [
        { "url": "*://(\\d+\\.\\d+\\.\\d+\\.\\d+)" },
        { "url": "*://[*]" },
        { "url": "*://([^.]+)" },
        { "url": "*://([^.]+\\.)" },
        { "url": "*://*.local" },
        { "url": "*://*.local." },
        { "url": "*://*.localhost" },
        { "url": "*://*.localhost." },
        { "url": "*://*.localdomain" },
        { "url": "*://*.localdomain." },
        { "url": "*://*.internal" },
        { "url": "*://*.internal." },
        { "url": "*://*.lan" },
        { "url": "*://*.lan." },
        { "url": "*://*.home.arpa" },
        { "url": "*://*.home.arpa." },
        { "url": "*://*.intranet" },
        { "url": "*://*.intranet." },
        { "url": "*://*.corp" },
        { "url": "*://*.corp." }
      ]
    },
    "dialog:default",
    "opener:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "fs:deny-default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-rename",
    "fs:allow-read-dir",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/backgrounds" }]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{ "path": "$APPDATA/backgrounds/*" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/backgrounds/*" }]
    },
    "allow-offline-dir"
  ]
}
