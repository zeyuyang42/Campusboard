{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: local database, Bandcamp fetches, theme files",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.bandcamp.com" },
        { "url": "https://bandcamp.com" },
        { "url": "https://*.bcbits.com" }
      ]
    },
    "dialog:default",
    "opener:default",
    "fs:default",
    "fs:scope-appdata-recursive",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove"
  ]
}
