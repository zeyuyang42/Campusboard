{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bandcamp Player",
  "version": "0.4.0",
  "identifier": "com.bandcampplayer.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w web",
    "beforeBuildCommand": "npm run build -w web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bandcamp Player",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "center": true,
        "backgroundColor": "#23262D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src https://*.bcbits.com blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "13.3" }
  },
  "plugins": {
    "http": { "scopeRedirects": true }
  }
}
